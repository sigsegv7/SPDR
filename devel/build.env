. devel/vars.env

export SERVICE_PACK=$DEFAULT_SERVICE_PACK
export ARCH_TARGET=$DEFAULT_ARCH_TARGET
export SPDR_ENV_EXPORTED=1
export PROJECT_ROOT=$(pwd)
export BASE_DIR=$PROJECT_ROOT/$SERVICE_PACK/base
export PS1="~ $PS1"
